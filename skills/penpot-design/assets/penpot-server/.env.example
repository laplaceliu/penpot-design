# Why: docker compose auto-loads `.env` from the directory holding
# compose.yaml, so this file is the single place to change deployment settings.
# Copy it to `.env` and adjust — `.env` is gitignored, this template is not.

# Image tag for the four penpotapp/* images. Must match what ./scripts/prewarm.sh
# pulls (it reads the same variable).
PENPOT_IMAGE_TAG=2.18

# Public origin injected into API responses. Must match the Caddy site block in
# caddy/Caddyfile and the /etc/hosts entry created by ./scripts/up.sh.
# Override PENPOT_HOST in the environment to use a different hostname.
PENPOT_PUBLIC_URI=https://penpot.local

# Shared HMAC secret for the backend <-> exporter handshake. Rotate this before
# exposing the instance beyond localhost — the default is intentionally public.
PENPOT_SECRET_KEY=change-me-in-production-please
