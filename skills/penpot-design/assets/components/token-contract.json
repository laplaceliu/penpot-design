      "type": "borderRadius",
      "token": "radius.full",
      "aliases": [
        "radius.pill",
        "radius.control"
      ],
      "description": "Control corner. A pill is the default; a project may map this role to its own control step."
    },
    "radius.field": {
      "type": "borderRadius",
      "token": "radius.md",
      "aliases": [
        "radius.input",
        "radius.field"
      ],
      "description": "Field / input corner."
    },
    "radius.card": {
      "type": "borderRadius",
      "token": "radius.lg",
      "aliases": [
        "radius.panel",
        "radius.card",
        "radius.surface"
