    "color.success": {
      "type": "color",
      "token": "color.success-ink",
      "aliases": [
        "color.success"
      ],
      "description": "Success solid / ink step."
    },
    "color.success-soft": {
      "type": "color",
      "token": "color.success-soft",
      "aliases": [],
      "description": "Success wash."
    },
    "color.warning": {
      "type": "color",
      "token": "color.warning-ink",
      "aliases": [
        "color.warning"
      ],
      "description": "Warning solid / ink step."
    },
    "color.warning-soft": {
      "type": "color",
      "token": "color.warning-soft",
      "aliases": [],
      "description": "Warning wash."
    },
    "color.info": {
      "type": "color",
      "token": "color.info-ink",
      "aliases": [
        "color.info"
      ],
      "description": "Info solid / ink step."
    },
    "color.info-soft": {
      "type": "color",
      "token": "color.info-soft",
      "aliases": [],
      "description": "Info wash."
    },
    "type.title": {
      "type": "typography",
      "token": "type.h3",
      "aliases": [
        "type.title",
        "type.heading-md",
        "type.heading"
      ],
      "description": "Component/panel title."
    },
    "type.heading": {
      "type": "typography",
      "token": "type.h2",
      "aliases": [
        "type.heading",
        "type.heading-lg",
        "type.h1"
      ],
      "description": "Screen heading."
    },
    "type.body": {
      "type": "typography",
      "token": "type.body",
      "aliases": [
        "type.body-md",
        "type.paragraph",
        "type.text"
      ],
      "description": "Body copy."
    },
    "type.label": {
      "type": "typography",
      "token": "type.label",
      "aliases": [
        "type.label-md",
        "type.button",
        "type.control"
      ],
      "description": "Control label."
    },
    "type.caption": {
      "type": "typography",
      "token": "type.caption",
      "aliases": [
        "type.small",
        "type.overline"
      ],
      "description": "Caption / metadata."
    },
