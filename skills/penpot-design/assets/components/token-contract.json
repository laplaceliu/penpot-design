      "type": "borderRadius",
      "token": "radius.sm",
      "aliases": [
        "radius.tag",
        "radius.badge",
        "radius.chip"
      ],
      "description": "Small box / badge / checkbox corner."
    },
    "radius.none": {
      "type": "borderRadius",
      "token": "radius.none",
      "aliases": [
        "radius.0"
      ],
      "description": "Square corner."
    },
    "space.xs": {
      "type": "spacing",
      "token": "spacing.xs",
      "aliases": [
        "spacing.1",
        "space.xs"
      ],
      "description": "Tight gap."
    },
    "space.sm": {
      "type": "spacing",
      "token": "spacing.sm",
      "aliases": [
        "spacing.2",
        "space.sm"
      ],
      "description": "Inline gap."
    },
    "space.md": {
      "type": "spacing",
      "token": "spacing.md",
      "aliases": [
        "spacing.3",
        "space.md"
      ],
      "description": "Control/internal gap."
    },
    "space.lg": {
      "type": "spacing",
      "token": "spacing.lg",
      "aliases": [
        "spacing.4",
        "space.lg"
      ],
      "description": "Block gap."
    },
    "shadow.card": {
      "type": "shadow",
      "token": "shadow.card",
      "aliases": [
        "shadow.raised",
        "elevation.card"
      ],
      "description": "Raised card / modal stack."
    },
    "shadow.control": {
      "type": "shadow",
      "token": "shadow.control",
      "aliases": [
        "shadow.button",
        "elevation.control"
      ],
      "description": "Lifted control stack."
    },
    "stroke.focus": {
      "type": "borderWidth",
      "token": "border-width.focus",
      "aliases": [
        "border.focus"
      ],
      "description": "Focus ring width."
    },
    "stroke.hairline": {
      "type": "borderWidth",
      "token": "border-width.1",
      "aliases": [
        "border.1"
      ],
      "description": "Hairline border width."
    }
  },
  "required": [
    "color.brand",
    "color.on-brand",
    "color.surface",
    "color.text",
    "color.text-muted",
    "color.border",
    "radius.control",
    "type.label",
    "type.body"
  ]
}
