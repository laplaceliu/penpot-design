{
  "version": 1,
  "name": "penpot-design semantic token roles",
  "description": "Components bind to roles, never to raw values. A role resolves to one live Penpot token; aliases cover the naming variants emitted by DESIGN.md and by older projects.",
  "roles": {
    "color.brand": {
      "type": "color",
      "token": "color.primary",
      "aliases": [
        "color.brand",
        "color.accent"
      ],
      "description": "Brand hue. Graphics, rings, solid brand fills."
    },
    "color.brand-ink": {
      "type": "color",
      "token": "color.primary-ink",
      "aliases": [
        "color.brand-ink"
      ],
      "description": "Readable brand step for copy on a wash and for solid brand surfaces that carry white copy."
    },
    "color.brand-soft": {
      "type": "color",
      "token": "color.primary-soft",
      "aliases": [
        "color.brand-soft"
      ],
      "description": "Brand wash."
    },
    "color.on-brand": {
      "type": "color",
      "token": "color.on-primary",
      "aliases": [
        "color.on-brand"
      ],
      "description": "Copy on a brand-ink solid."
    },
    "color.surface": {
      "type": "color",
      "token": "color.surface",
      "aliases": [
        "color.bg",
        "color.background"
      ],
      "description": "Default surface."
    },
    "color.surface-alt": {
      "type": "color",
      "token": "color.surface-alt",
      "aliases": [
        "color.surface-alt2",
        "color.neutral"
      ],
      "description": "Quiet surface / filled field."
    },
    "color.surface-raised": {
      "type": "color",
      "token": "color.surface-raised",
      "aliases": [
        "color.raised",
        "color.surface"
      ],
      "description": "Raised panel (card, modal, popover)."
    },
    "color.text": {
      "type": "color",
      "token": "color.text-bright",
      "aliases": [
        "color.ink",
        "color.on-surface"
      ],
      "description": "Primary copy."
    },
    "color.text-muted": {
      "type": "color",
      "token": "color.text-muted",
      "aliases": [
        "color.muted",
        "color.secondary"
      ],
      "description": "Secondary copy."
    },
    "color.border": {
      "type": "color",
      "token": "color.border",
      "aliases": [
        "color.divider",
        "color.outline"
      ],
      "description": "Hairline border."
    },
    "color.border-strong": {
      "type": "color",
      "token": "color.border-strong",
      "aliases": [
        "color.outline-strong"
      ],
      "description": "Control border / stronger divider."
