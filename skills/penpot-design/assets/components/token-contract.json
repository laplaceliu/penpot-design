    "color.focus": {
      "type": "color",
      "token": "color.primary",
      "aliases": [
        "color.focus",
        "color.ring",
        "color.brand"
      ],
      "description": "Focus ring. Falls back to the brand hue."
    },
    "color.inverse": {
      "type": "color",
      "token": "color.inverse-raised",
      "aliases": [
        "color.inverse",
        "color.dark-raised",
        "color.ink-raised"
      ],
      "description": "Dark/inverse raised surface (tooltip, dark toast)."
    },
    "color.on-inverse": {
      "type": "color",
      "token": "color.on-inverse",
      "aliases": [
        "color.on-dark"
      ],
      "description": "Copy on an inverse surface."
